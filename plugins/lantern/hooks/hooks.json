{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "${CLAUDE_PLUGIN_ROOT}/lantern.py",
              "hook",
              "session-start"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "${CLAUDE_PLUGIN_ROOT}/lantern.py",
              "hook",
              "user-prompt-submit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "${CLAUDE_PLUGIN_ROOT}/lantern.py",
              "hook",
              "stop"
            ],
            "async": true
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "${CLAUDE_PLUGIN_ROOT}/lantern.py",
              "hook",
              "signal"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "${CLAUDE_PLUGIN_ROOT}/lantern.py",
              "hook",
              "pre-tool-use"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "--no-project",
              "--quiet",
              "${CLAUDE_PLUGIN_ROOT}/lantern.py",
              "hook",
              "subagent-stop"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
